<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/service_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/service_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/service_widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/service_widget_choose" android:textColor="@color/service_widget_foreground" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/service_widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/service_widget_unknown" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/service_widget_uptime" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/service_widget_empty_uptime" android:textColor="@color/service_widget_foreground" android:textSize="30sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/service_widget_period" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/service_widget_period" android:textColor="@color/service_widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <ImageView android:id="@+id/service_widget_graph" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:minHeight="24dp" android:scaleType="fitXY" android:contentDescription="@string/service_widget_description" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/service_widget_start" android:textColor="@color/service_widget_muted" android:textSize="11sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/service_widget_end" android:textColor="@color/service_widget_muted" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/service_widget_up"
            android:textColor="@color/service_widget_up" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/service_widget_down"
            android:textColor="@color/service_widget_down" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/service_widget_unknown"
            android:textColor="@color/service_widget_muted" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/service_widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="@color/service_widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
